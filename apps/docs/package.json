{
  "name": "@mandarelabs/docs",
  "version": "0.1.0",
  "description": "Mandare documentation site (mandare.dev) \u2014 quickstart, concepts, threat model, integrations, reference. Built with Fumadocs.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "fumadocs-mdx && next build",
    "dev": "fumadocs-mdx && next dev --hostname 127.0.0.1 --port 8789",
    "start": "next start --hostname 127.0.0.1 --port 8789",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "lint": "eslint app lib",
    "test": "vitest run"
  },
  "dependencies": {
    "fumadocs-core": "^15.8.5",
    "fumadocs-mdx": "^11.10.1",
    "fumadocs-ui": "^15.8.5",
    "next": "~15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/mdx": "^2.0.13",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "vitest": "^3.0.0"
  }
}
