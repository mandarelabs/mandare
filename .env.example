# Mandare — local secrets layout. Copy to `.env` and fill in what you use.
# `.env` is gitignored and must NEVER be committed (rule R2); CI runs with no
# secrets at all — everything secret-dependent is a local, optional smoke test.

# Primary live-smoke provider (recommended: use Haiku via model config — cheapest)
ANTHROPIC_API_KEY=

# Second provider (optional, for multi-provider adapter tests)
OPENAI_API_KEY=

# Optional extra providers (OpenAI-compatible endpoints — adapters can come later)
# KIMI_API_KEY=

# OpenRouter — DEFERRED, not needed now. Add later for the provisioning-key rail demo.
# OPENROUTER_API_KEY=
# OPENROUTER_PROVISIONING_KEY=

# --- Vault (S3) --------------------------------------------------------------
# From S3 on, provider keys should live in the VAULT, not here. Bootstrap once:
#   mandare vault import-env      # reads the keys above INTO the vault
# then REMOVE them from .env. The gateway reads them from the vault when run
# with MANDARE_VAULT=1 (agents never see a raw key).
#
# MANDARE_VAULT=1                 # gateway sources door key + provider keys from the vault
# MANDARE_VAULT_BACKEND=keychain  # 'keychain' (default, OS keychain) | 'file' (headless/CI)
# MANDARE_VAULT_DB=./mandare-vault.db
# MANDARE_VAULT_KEY_FILE=./mandare-vault.db.masterkey   # file backend only (0600)

# --- Passports & approvals (S4) ----------------------------------------------
# Issue a passport + mandate, then run the gateway in passport mode:
#   mandare passport issue --agent-name my-agent   # prints the authority DID
#   mandare mandate issue --agent <did:key> --out mandate.sdjwt --approval-above 0.25
# MANDARE_GATEWAY_AUTH=passport   # 'auto' | 'token' | 'passport' | 'none'
# MANDARE_TRUST_AUTHORITY=did:key:...   # the attestation authority the door trusts
# MANDARE_NOTIFIER=ntfy           # 'none' (default) | 'ntfy' | 'file'
# MANDARE_NTFY_URL=https://ntfy.sh
# MANDARE_NTFY_TOPIC=mandare-approvals-<random>   # your private topic
# MANDARE_NOTIFY_FILE=./approvals.jsonl           # file channel (CI/demos)
# MANDARE_APPROVAL_TIMEOUT_MS=120000              # no decision by then = deny (fail-closed)
# MANDARE_MAX_PENDING_APPROVALS=8                 # cap on calls held awaiting a human (flood guard)
# MANDARE_GATEWAY_PUBLIC_URL=http://127.0.0.1:8484  # base URL the push buttons POST back to

# --- Card rail (S5, Stripe Issuing) ------------------------------------------
# TEST-MODE keys only until launch (the live smoke refuses non-sk_test keys).
# The rail mounts IFF STRIPE_WEBHOOK_SECRET is set; `stripe listen` prints one
# for local runs (`pnpm card-live-smoke` automates the whole flow). Vault mode
# imports both via `mandare vault import-env` — then remove them from here.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CARDHOLDER_ID=ich_...    # Issuing cardholder new cards belong to
# STRIPE_API_BASE=https://api.stripe.com   # injectable for mocks
# STRIPE_API_VERSION=             # optional pinned Stripe-Version
# STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# MANDARE_CARD_WAIVER_TTL_MS=600000   # step-up waiver lifetime after an approval
