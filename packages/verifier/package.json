  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mandarelabs/mandare.git",
    "directory": "packages/verifier"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
