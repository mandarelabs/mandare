{
  "name": "@mandarelabs/passport",
  "version": "0.1.0",
  "description": "Mandare passport: did:key identity, owner→agent delegation credentials (SD-JWT VC), mandate transport, and RFC 9421 request signatures — verifiable by anyone, offline",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@mandarelabs/spec": "workspace:*",
    "@sd-jwt/core": "^0.20.0",
    "@sd-jwt/sd-jwt-vc": "^0.20.0",
    "web-bot-auth": "^0.1.3"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  }
}
