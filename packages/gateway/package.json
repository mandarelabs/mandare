{
  "name": "@mandarelabs/gateway",
  "version": "0.1.0",
  "description": "Mandare gateway: local LLM proxy that enforces policy pre-call and writes the ledger before and after every action",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "red-team": "vitest run test/red-team",
    "start": "node dist/start.js"
  },
  "dependencies": {
    "@mandarelabs/ledger": "workspace:*",
    "@mandarelabs/passport": "workspace:*",
    "@sinclair/typebox": "^0.34.0",
    "@mandarelabs/policy-engine": "workspace:*",
    "@mandarelabs/spec": "workspace:*",
    "@mandarelabs/vault": "workspace:*",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@mandarelabs/verifier": "workspace:*",
    "vitest": "^3.0.0"
  }
}
