  "description": "Mandare append-only ledger: hash-chained, door-signed entries in local SQLite",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
