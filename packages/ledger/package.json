{
  "name": "@mandarelabs/ledger",
  "version": "0.1.0",
  "description": "Mandare append-only ledger: hash-chained, door-signed entries in local SQLite",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mandarelabs/mandare.git",
    "directory": "packages/ledger"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "red-team": "vitest run test/red-team",
    "bench": "node bench/append-bench.mjs"
  },
  "dependencies": {
    "@mandarelabs/spec": "workspace:*",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@mandarelabs/verifier": "workspace:*",
    "@types/pg": "^8.11.0",
    "embedded-postgres": "17.10.0-beta.17",
    "vitest": "^3.0.0"
  }
}
